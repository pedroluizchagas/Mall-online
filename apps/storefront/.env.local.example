# apps/storefront — variáveis de ambiente (dev local)
# Copie para .env.local e preencha. NUNCA commitar .env.local.

# Supabase (compartilhado com web/admin/mobile — mesmo projeto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   # URL do projeto (exposta ao cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx                        # Anon key (RLS aplicado; lê só views públicas — D2)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx                            # service_role — APENAS servidor

# Pagar.me (tokenização client-side de cartão no checkout — Stage 3)
NEXT_PUBLIC_PAGARME_APPID=appid_test_xxx                    # appId público do Pagar.me

# App
APP_URL=http://localhost:3002                               # URL base do storefront (dev | prod: https://*.mallevo.com.br)

# Hosts
# O middleware só atende mallevo.com.br, mallevo.localhost e localhost; qualquer
# outro host responde 404 (evita domínio de terceiro servindo o saguão). Ligue
# apenas em ambientes de preview da Vercel, onde o host é *.vercel.app.
NEXT_PUBLIC_ALLOW_UNKNOWN_HOST=false

