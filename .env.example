# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   # URL do projeto Supabase (exposta ao cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx                        # Anon key (RLS aplicado)
SUPABASE_SERVICE_ROLE_KEY=eyJxxx                            # service_role — APENAS servidor / Edge Functions
SUPABASE_PROJECT_ID=xxxxxxxxxxxx                            # Reference ID (usado pelo Supabase CLI)

# Pagar.me (pedidos)
PAGARME_API_KEY=ak_test_xxx                                 # Chave secreta de API — APENAS Edge Functions
PAGARME_WEBHOOK_SECRET=whsec_xxx                            # Secret HMAC do webhook (header X-Hub-Signature)
PAGARME_PLATFORM_RECIPIENT_ID=rp_test_xxx                   # recipient_id da Mallevo (recebedor padrão da plataforma)
NEXT_PUBLIC_PAGARME_APPID=appid_test_xxx                    # appId público do Pagar.me — tokenização client-side (apps/storefront)

# Stripe Billing (assinatura do lojista — NÃO é Stripe Connect)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx              # Publishable key — usada apenas pelo Customer Portal web
STRIPE_SECRET_KEY=sk_test_xxx                               # Secret key — APENAS servidor (assinaturas)
STRIPE_WEBHOOK_SECRET=whsec_xxx                             # Secret de assinatura do webhook Stripe Billing

# Apps
APP_URL=http://localhost:3000                               # URL base do dashboard (dev | prod: https://app.mallevo.com.br)

# Expo
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   # Mesma URL do Supabase, embutida no bundle mobile
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxx                        # Anon key embutida no bundle mobile
EXPO_PUBLIC_PAGARME_APPID=appid_test_xxx                    # appId público do Pagar.me — tokenização client-side de cartão
EXPO_PUBLIC_APP_URL=http://localhost:3000                   # URL da app web (deep links e callbacks no mobile)
# Project ID do Expo (push tokens via expo-notifications; encontrado em expo.dev > projeto > ID)
EXPO_PUBLIC_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
