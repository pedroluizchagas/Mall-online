{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "paths": {
      "@mallevo/types": ["./packages/types/index.ts"],
      "@mallevo/lib": ["./packages/lib/index.ts"]
    }
  }
}
